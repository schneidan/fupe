DATABASE_URL=postgresql://fupe:fupe_dev@localhost:5433/fupe
PORT=3000
CORS_ORIGIN=http://localhost:3001
NODE_ENV=development
JWT_SECRET=change-me-in-production
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Optional: OpenAI for Whisper transcription and Vision OCR fallback
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
WHISPER_MODEL=whisper-1

# Open Food Facts API base (barcode fallback)
OPEN_FOOD_FACTS_URL=https://world.openfoodfacts.org/api/v2/product

# Phase 6.2 — Stripe (Test mode: dashboard.stripe.com/test)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_DEVELOPER=price_...
# STRIPE_PRICE_BUSINESS=price_...
# Local webhooks: stripe listen --forward-to localhost:3000/api/v1/billing/webhook

# REQUIRE_API_KEY=false
# LOOKUP_IP_RATE_LIMIT_PER_MIN=60
# Shared with web (server-only) + mobile (--dart-define). Required in production for first-party IMAGE.
# FIRST_PARTY_LOOKUP_SECRET=generate-a-long-random-string
# IMAGE: paid API key OR X-Fupe-First-Party header matching the secret (anonymous third parties blocked)

# Email — default is console (link logged in API output).
# Mailpit locally: UI http://localhost:8025, SMTP 127.0.0.1:1025
# EMAIL_PROVIDER=console
#
# Resend (recommended for production): https://resend.com
#   1. Verify domain fupe.app (DNS records Resend shows)
#   2. Create API key
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_...
# EMAIL_FROM=FUPE <noreply@fupe.app>
#
# Or any SMTP (including Resend SMTP: smtp.resend.com / user resend / pass=API key)
# EMAIL_PROVIDER=smtp
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# EMAIL_FROM=FUPE <noreply@fupe.local>
# AUTO_VERIFY_EMAIL=true
# BOOTSTRAP_MODERATOR_EMAIL=you@example.com
# BOOTSTRAP_ADMIN_EMAIL=you@example.com   ← grants admin on register OR next login
