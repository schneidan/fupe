# Baked into the Next.js client/build. Local `next dev` defaults to development
# (red favicon slash) when this is unset.
#
# NEXT_PUBLIC_FUPE_ENV=development   # red slash
# NEXT_PUBLIC_FUPE_ENV=staging       # yellow slash
# NEXT_PUBLIC_FUPE_ENV=production    # clean mark (default for next build)

API_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3001
