{
  "name": "fupe",
  "version": "0.1.0",
  "private": true,
  "description": "Find Ultimate Parent Entity — corporate ownership transparency",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:reset-volume": "docker compose down -v",
    "db:migrate": "pnpm --filter @fupe/db migrate",
    "db:setup": "docker compose up -d postgres && pnpm db:migrate",
    "db:reset": "pnpm --filter @fupe/db reset",
    "ingest": "pnpm --filter @fupe/ingest ingest"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}
